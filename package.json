{
  "name": "nomue-record",
  "version": "0.0.0",
  "private": true,
  "description": "nomue Protocol / nomue Record Specification (NRS) Layer 1 public specification repository",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx tooling/src/generate.ts",
    "validate": "tsx tooling/src/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2",
    "check:generated": "tsx tooling/src/generate.ts --check",
    "nomue-record": "tsx reference/verifier/src/cli.ts",
    "schema:validate": "tsx tooling/src/phase1/schema-validate.ts",
    "schema:generate-types": "tsx tooling/src/phase1/generate-types.ts",
    "canonicalization:test": "tsx tooling/src/phase1/canonicalization-test.ts",
    "conformance:test": "tsx tooling/src/phase1/conformance-run.ts",
    "verifier:test": "vitest run tooling/tests/kernel.test.ts tooling/tests/jcs.test.ts tooling/tests/verifier.test.ts",
    "verifier:example": "tsx tooling/src/phase1/verifier-example.ts",
    "evidence:phase1": "tsx tooling/src/phase1/evidence-phase1.ts",
    "check:phase1": "pnpm schema:validate && pnpm canonicalization:test && pnpm conformance:test && pnpm verifier:example && pnpm evidence:phase1 --check",
    "regression:phase1": "tsx tooling/src/phase1/conformance-run.ts --exclude A2-",
    "conformance:phase2a": "tsx tooling/src/phase1/conformance-run.ts --include A2-",
    "refusal:test": "tsx tooling/src/phase1/conformance-run.ts --include A2-R",
    "verifier:example:phase2a": "tsx tooling/src/phase2a/verifier-example-2a.ts",
    "oracle:phase2a": "tsx tooling/src/phase2a/oracle-check.ts",
    "oracle:r1-08": "tsx tooling/r1-08-oracle/src/run.ts",
    "evidence:r2-paired-t:validate": "node --import tsx tooling/src/spikes/validate-paired-t-evidence-bundle.ts",
    "evidence:r2-paired-t-runtime-series:validate": "node --import tsx tooling/src/spikes/validate-paired-t-runtime-series-evidence.ts",
    "evidence:r2-paired-t-runtime-series:probe": "node --import tsx tooling/src/spikes/probe-paired-t-runtime-series-evidence.ts",
    "evidence:r2-paired-t-runtime-inverse-beta-table:validate": "node --import tsx tooling/src/spikes/validate-paired-t-runtime-inverse-beta-table-evidence.ts",
    "evidence:r2-paired-t-runtime-inverse-beta-table:probe": "node --import tsx tooling/src/spikes/probe-paired-t-runtime-inverse-beta-table-evidence.ts",
    "evidence:r2-paired-t-truth-boundary:validate": "node --import tsx tooling/src/spikes/validate-paired-t-truth-boundary-evidence.ts",
    "evidence:r2-paired-t-truth-boundary:probe": "node --import tsx tooling/src/spikes/probe-paired-t-truth-boundary-evidence.ts",
    "evidence:phase2a": "tsx tooling/src/phase2a/evidence-phase2a.ts",
    "snapshot:manifest": "tsx tooling/src/release/snapshot-manifest-cli.ts",
    "release:signing:prepare": "tsx tooling/src/release/release-signing-cli.ts prepare",
    "release:signing:verify": "tsx tooling/src/release/release-signing-cli.ts verify",
    "trust-root:fingerprint": "tsx tooling/src/release/trust-root-fingerprint.ts",
    "evidence:offline-verification": "tsx tooling/src/evidence/run-offline-verification.ts",
    "evidence:oracle-matrix": "tsx tooling/src/evidence/oracle-matrix-generate.ts",
    "evidence:oracle-summary": "tsx tooling/src/evidence/oracle-deviation-summary.ts",
    "evidence:oracle-rel-diff": "tsx tooling/src/evidence/oracle-rel-diff-matrix.ts",
    "evidence:oracle-floor-map": "tsx tooling/src/evidence/oracle-floor-map.ts",
    "fuzz": "tsx tooling/src/fuzz/schema-guided-fuzzer.ts",
    "check:phase2a": "pnpm regression:phase1 && pnpm conformance:phase2a && pnpm verifier:example:phase2a && pnpm refusal:test && pnpm oracle:phase2a && pnpm evidence:phase2a --check",
    "conformance:phase2a-021": "tsx tooling/src/phase1/conformance-run.ts --include A2-1-",
    "check:phase2a-021": "pnpm conformance:phase2a-021",
    "check": "pnpm format:check && pnpm lint:markdown && pnpm typecheck && pnpm validate && pnpm test && pnpm check:generated && pnpm check:phase1 && pnpm check:phase2a && pnpm check:phase2a-021"
  },
  "devDependencies": {
    "@stdlib/stats-base-dists-t-cdf": "^0.2.3",
    "@stdlib/stats-base-dists-t-quantile": "^0.2.3",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^3.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
