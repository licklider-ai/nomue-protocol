{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nomue:schema:clarification:0.1.0-draft.1",
  "title": "nomue needs_clarification",
  "description": "Structured insufficiency response (NRS-CORE-0015/0018): machine-readable enumeration of what is missing and the expected form of each answer. The interactive protocol that fills it is Layer 2 (NRS-CORE-0002).",
  "type": "object",
  "required": ["$schema", "clarification_type", "operation", "missing"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:nomue:schema:clarification:0.1.0-draft.1"
    },
    "clarification_type": {
      "const": "needs_clarification"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "missing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["what", "why", "expected_form"],
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "expected_form": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["schema_ref", "enum", "free_text"]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
