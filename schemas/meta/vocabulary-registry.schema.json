{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:vocabulary-registry",
  "title": "NRS vocabulary registry",
  "description": "Meta-schema for registries/vocabulary.yaml.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "terms"],
  "additionalProperties": false,
  "properties": {
    "registry": { "const": "nrs-vocabulary" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "required": ["term", "definition"],
      "additionalProperties": false,
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
