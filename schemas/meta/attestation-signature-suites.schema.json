{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:attestation-signature-suites",
  "title": "NRS attestation signature suite allow-list",
  "description": "Meta-schema for registries/attestation-signature-suites.yaml. The allow-list a signature's `algorithm` field is validated against (NRS-ATTEST-0003); a suite's `status` distinguishes a technical proposal from an adopted decision.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "suites"],
  "additionalProperties": false,
  "properties": {
    "registry": { "const": "nrs-attestation-signature-suites" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "required": [
        "suite_id",
        "algorithm",
        "status",
        "rationale",
        "requirement_ids",
        "introduced_in"
      ],
      "additionalProperties": false,
      "properties": {
        "suite_id": {
          "type": "string",
          "pattern": "^urn:nomue:signature-suite:[a-z0-9-]+:[0-9]+$"
        },
        "algorithm": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["proposed", "adopted", "withdrawn"],
          "$comment": "proposed = a technical proposal only, not a review decision; adopted = accepted via the RFC process; withdrawn = tombstoned, never reused (governance/ID-POLICY.md)."
        },
        "rationale": { "type": "string", "minLength": 1 },
        "requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NRS-[A-Z][A-Z-]*-[0-9]{4}$" }
        },
        "introduced_in": { "type": "string", "minLength": 1 },
        "superseded_by": {
          "anyOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
