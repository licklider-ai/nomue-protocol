{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:stability-tiers",
  "title": "NRS stability tier registry",
  "description": "Meta-schema for registries/stability-tiers.yaml.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "tiers"],
  "additionalProperties": false,
  "properties": {
    "registry": { "const": "nrs-stability-tiers" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/tier" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": [
        "tier",
        "summary",
        "compatibility",
        "rfc_min_discussion_days",
        "approval",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["CORE", "STABLE-INTENT", "EXPERIMENTAL"] },
        "summary": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "minLength": 1 },
        "rfc_min_discussion_days": { "type": "integer", "minimum": 1 },
        "approval": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
