{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:reason-codes-registry",
  "title": "NRS reason code registry",
  "description": "Meta-schema for registries/reason-codes.yaml.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "codes"],
  "additionalProperties": false,
  "properties": {
    "registry": { "const": "nrs-reason-codes" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/code" }
    }
  },
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^NRS-(GOV|CORE|VERIFY|CANON|ATTEST|EXT|SEC|VERSION|INTEROP|PROV|EMIT|APPROVE|PROFILE-ITGC)-[0-9]{4}$"
    },
    "code": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "description",
        "applicable_check_ids",
        "requirement_ids",
        "stability",
        "remediation_hint",
        "introduced_in"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NRS-[A-Z][A-Z-]*[A-Z]$",
          "$comment": "Reason codes carry no numeric suffix, so they never collide with requirement IDs."
        },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "structural",
            "semantic",
            "integrity",
            "precondition",
            "admissibility",
            "computability",
            "comparison",
            "bundle",
            "resource",
            "internal",
            "attestation",
            "approval"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "applicable_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+$" },
          "$comment": "Every check whose result may carry the code, including not_run propagation. Empty for codes that appear only in verifier refusal artifacts."
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementId" }
        },
        "stability": { "enum": ["CORE", "STABLE-INTENT", "EXPERIMENTAL"] },
        "remediation_hint": { "type": "string", "minLength": 1 },
        "introduced_in": { "type": "string", "minLength": 1 }
      }
    }
  }
}
