{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:release-gates",
  "title": "NRS Release 1 gate registry",
  "description": "Meta-schema for authority/release-1-gates.yaml. There is deliberately no conditional_pass decision.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "gates"],
  "additionalProperties": false,
  "properties": {
    "registry": { "const": "nrs-release-1-gates" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "gate_id",
        "title",
        "purpose",
        "applicability",
        "state",
        "decision",
        "required_evidence",
        "blocking_categories",
        "related_requirement_ids",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "gate_id": { "type": "string", "pattern": "^R1-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "minLength": 1 },
        "state": { "enum": ["open", "ready_for_review", "closed"] },
        "decision": {
          "anyOf": [{ "type": "null" }, { "enum": ["pass", "fail", "not_applicable"] }]
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocking_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "core_semantics",
              "guarantee_boundary",
              "security",
              "rights",
              "legal",
              "reproducibility",
              "evidence_integrity"
            ]
          }
        },
        "related_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NRS-(GOV|CORE|VERIFY|CANON|ATTEST|EXT|SEC|VERSION|INTEROP|PROFILE-ITGC)-[0-9]{4}$"
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
