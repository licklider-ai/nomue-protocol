{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:public-checks-registry",
  "title": "NRS public check registry",
  "description": "Meta-schema for registries/public-checks.yaml. Tolerance policy is owned by check versions, never by Records.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "check_sets", "checks"],
  "additionalProperties": false,
  "properties": {
    "registry": { "const": "nrs-public-checks" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "check_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "check_ids"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "minLength": 1 },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+$" }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^NRS-(GOV|CORE|VERIFY|CANON|ATTEST|EXT|SEC|VERSION|INTEROP|PROFILE-ITGC)-[0-9]{4}$"
    },
    "tolerancePair": {
      "type": "object",
      "required": ["absolute", "relative"],
      "additionalProperties": false,
      "properties": {
        "absolute": { "type": "number", "minimum": 0 },
        "relative": { "type": "number", "minimum": 0 }
      }
    },
    "tolerancePolicy": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["not_applicable", "exact", "numeric"] },
        "exact_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "numeric_tolerances": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/tolerancePair" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "numeric" } } },
          "then": { "required": ["numeric_tolerances"] }
        }
      ]
    },
    "check": {
      "type": "object",
      "required": [
        "check_id",
        "title",
        "version",
        "stability",
        "scope_kind",
        "calculation_evidence",
        "consistency_evidence",
        "signature_evidence",
        "claim_posture",
        "requirement_ids",
        "tolerance_policy",
        "implementation_status",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "check_id": { "type": "string", "pattern": "^urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "stability": { "enum": ["CORE", "STABLE-INTENT", "EXPERIMENTAL"] },
        "scope_kind": { "enum": ["record", "record_revision", "analysis", "result"] },
        "calculation_evidence": { "enum": ["recomputed", "consistency_only", "not_checked"] },
        "consistency_evidence": { "enum": ["checked", "not_checked"] },
        "signature_evidence": { "enum": ["verified", "failed", "not_checked"] },
        "claim_posture": { "enum": ["asserted", "not_asserted"] },
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+$" }
        },
        "dependency_propagation": {
          "const": "not_run_with_blocking_reason_codes",
          "$comment": "When a depends_on check fails, is not run, or errors, the dependent check is not_run and carries the blocking reason codes (NRS-VERIFY-0017)."
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementId" }
        },
        "tolerance_policy": { "$ref": "#/$defs/tolerancePolicy" },
        "comparison_constants": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "$comment": "Machine-readable constants owned by the check version (e.g. the supported confidence level); the reference verifier fails loud if these disagree with the implemented profile constants.",
          "properties": {
            "supported_confidence_level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "supported_ci_method_id": {
              "type": "string",
              "pattern": "^urn:nomue:method:[a-z0-9-]+:[A-Za-z0-9.-]+$"
            },
            "supported_estimand_kind": { "type": "string", "minLength": 1 }
          }
        },
        "implementation_status": { "enum": ["planned", "implemented"] },
        "notes": { "type": "string" }
      }
    }
  }
}
