  "requirements": [
    {
      "id": "NRS-CONTRACT-BTF-0001",
      "owner": "spec/contracts/balanced-two-factor/design-and-estimands.md",
      "title": "Design and directions",
      "text": "factor_order and level_order determine cells 00,01,10,11; effects use level 1 minus level 0.",
      "surfaces": ["input"],
      "sources": ["RFC"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CONTRACT-BTF-0002",
      "owner": "spec/contracts/balanced-two-factor/design-and-estimands.md",
      "title": "Three marginal contrasts",
      "text": "Full fixed four-column model and its three A/B/AB own-null contrasts; no joint calibration.",
      "surfaces": ["input", "declarations"],
      "sources": ["RFC"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CONTRACT-BTF-0003",
      "owner": "spec/contracts/balanced-two-factor/admissibility.md",
      "title": "Design admissibility",
      "text": "Four complete equally replicated cells, n >= 2, finite observed outcomes and distinct declared experimental units.",
      "surfaces": ["input", "admissibility"],
      "sources": ["RFC", "G5"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CONTRACT-BTF-0004",
      "owner": "spec/contracts/balanced-two-factor/admissibility.md",
      "title": "Model scope",
      "text": "Independent normal zero-mean errors, common finite positive variance and fixed means; declaration does not prove these facts.",
      "surfaces": ["input", "admissibility", "guarantee"],
      "sources": ["RFC"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CONTRACT-BTF-0005",
      "owner": "spec/contracts/balanced-two-factor/calculation.md",
      "title": "Exact targets",
      "text": "Use the one exact represented-input graph and three upper F tails; projection is separate.",
      "surfaces": ["declarations", "comparison"],
      "sources": ["RFC", "G5"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-PROFILE-BTF-0001",
      "owner": "spec/profiles/balanced-two-factor/declarations.md",
      "title": "Applicability declaration",
      "text": "Exact bundle Contract and required boolean model_applicability_declared; false is representable but inadmissible.",
      "surfaces": ["input", "admissibility"],
      "sources": ["RFC"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-PROFILE-BTF-0002",
      "owner": "spec/profiles/balanced-two-factor/non-claims.md",
      "title": "Bounded guarantee",
      "text": "Marginal, scoped claims only; no multiplicity, post-quantization or admission-conditional calibration.",
      "surfaces": ["guarantee"],
      "sources": ["RFC", "T03"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-PROFILE-BTF-0003",
      "owner": "spec/profiles/balanced-two-factor/representation.md",
      "title": "Closed numerical representation",
      "text": "All required finite fields, safe integer ranges and strictly positive declared SSE; no null, undefined, or negative-zero token.",
      "surfaces": ["declarations", "conformance"],
      "sources": ["RFC", "T03"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-PROFILE-BTF-0004",
      "owner": "spec/profiles/balanced-two-factor/representation.md",
      "title": "Local associations",
      "text": "Exact unique result/analysis/design/dataset and observation/cell references, factor/level order and Cartesian coverage.",
      "surfaces": ["input", "conformance"],
      "sources": ["RFC"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-VERIFY-0029",
      "owner": "spec/verification/factorial-recompute.md",
      "title": "Quantity binding",
      "text": "Exact result scope, RFC quantity names and applicable cell_id or contrast_kind; each of the 22 compared once.",
      "surfaces": ["comparison", "evidence"],
      "sources": ["RFC", "G5"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-VERIFY-0030",
      "owner": "spec/verification/factorial-recompute.md",
      "title": "Versioned numerical procedure",
      "text": "J-cost(B,S-C), Z-B, exact targets, projection gates and strict comparison as specified below; no reference-only caps.",
      "surfaces": ["computability", "comparison"],
      "sources": ["T03", "ARCH", "COST", "G5"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-VERIFY-0031",
      "owner": "spec/verification/factorial-recompute.md",
      "title": "Results and evidence",
      "text": "Bind revision/bundle/check version and quantity identity to outcomes, reasons and evidence without inventing projections or partial success.",
      "surfaces": ["evidence", "outcomes"],
      "sources": ["RFC", "T03", "ARCH", "G5", "F01"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-VERIFY-0032",
      "owner": "spec/verification/factorial-recompute.md",
      "title": "Check separation and execution",
      "text": "Both conformance stages gate all checks; integrity is independent of admissibility; execute only registered procedures, no Record code.",
      "surfaces": ["conformance", "integrity", "outcomes"],
      "sources": ["RFC", "ARCH"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CORE-0020",
      "owner": "spec/core/balanced-two-factor-envelope.md",
      "title": "Successor closed Record",
      "text": "New closed Record/payload, exact opaque Contract identity; no implicit dereference and no historical reinterpretation.",
      "surfaces": ["envelope", "input"],
      "sources": ["RFC", "ID-POLICY"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CORE-0021",
      "owner": "spec/core/balanced-two-factor-envelope.md",
      "title": "Canonical identity",
      "text": "Existing strict input, JCS and domain-separated digest excluding exactly root integrity; no normalization or algorithm alias.",
      "surfaces": ["envelope", "integrity"],
      "sources": ["RFC", "CANON"],
      "status": "UNISSUED CANDIDATE"
    },
    {
      "id": "NRS-CORE-0022",
      "owner": "spec/core/balanced-two-factor-lifecycle.md",
      "title": "Eligibility carrier",
      "text": "BTF admissibility completed pass/fail maps to eligible/ineligible; absent/error/not_run maps to not_evaluated.",
      "surfaces": ["admissibility", "outcomes"],
      "sources": ["RFC"],
      "status": "UNISSUED CANDIDATE"
    }
