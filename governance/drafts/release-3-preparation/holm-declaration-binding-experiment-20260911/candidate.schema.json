{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unissued D0 declaration exercise; not a nomue Record schema",
  "$comment": "Local exploratory surface only. Passing proves neither truth nor statistical admissibility. Method payloads are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "dataset", "design", "analyses", "families", "result_slots"],
  "properties": {
    "artifact_kind": {
      "const": "unissued-d0-declaration-exercise"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "outcome_definition", "scale_declaration", "observations"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome_definition": {
          "type": "string",
          "minLength": 1
        },
        "scale_declaration": {
          "const": "continuous"
        },
        "observations": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "experimental_unit_id", "group_id", "value"],
            "properties": {
              "observation_id": {
                "type": "string",
                "minLength": 1
              },
              "experimental_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "group_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_id",
        "kind",
        "experimental_unit_definition",
        "independence_declared",
        "not_flattened_declared",
        "groups",
        "units"
      ],
      "properties": {
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "independent_one_way"
        },
        "experimental_unit_definition": {
          "type": "string",
          "minLength": 1
        },
        "independence_declared": {
          "const": true
        },
        "not_flattened_declared": {
          "const": true
        },
        "groups": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group_id"],
            "properties": {
              "group_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "units": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["experimental_unit_id", "group_id"],
            "properties": {
              "experimental_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "group_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysis_id",
          "dataset_id",
          "design_id",
          "population",
          "family_id",
          "contract_ref",
          "procedure_selection",
          "variance_model",
          "assumption_statements"
        ],
        "properties": {
          "analysis_id": {
            "type": "string",
            "minLength": 1
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "design_id": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "object",
            "additionalProperties": false,
            "required": ["definition", "observation_ids"],
            "properties": {
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "observation_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "procedure_selection": {
            "$ref": "#/$defs/timing"
          },
          "variance_model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["declaration", "selection"],
            "properties": {
              "declaration": {
                "enum": ["common", "group_specific", "not_declared"]
              },
              "selection": {
                "$ref": "#/$defs/timing"
              }
            }
          },
          "assumption_statements": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_id", "analysis_id", "selection", "kind", "members"],
            "properties": {
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "selection": {
                "$ref": "#/$defs/timing"
              },
              "kind": {
                "const": "omnibus"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["member_id", "selection", "kind", "group_ids"],
                  "properties": {
                    "member_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "$ref": "#/$defs/timing"
                    },
                    "kind": {
                      "const": "omnibus"
                    },
                    "group_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                },
                "maxItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_id", "analysis_id", "selection", "kind", "members"],
            "properties": {
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "selection": {
                "$ref": "#/$defs/timing"
              },
              "kind": {
                "const": "all_pairs"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "member_id",
                    "selection",
                    "kind",
                    "minuend_group_id",
                    "subtrahend_group_id"
                  ],
                  "properties": {
                    "member_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "$ref": "#/$defs/timing"
                    },
                    "kind": {
                      "const": "pair"
                    },
                    "minuend_group_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subtrahend_group_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family_id",
              "analysis_id",
              "selection",
              "kind",
              "members",
              "control_group_id"
            ],
            "properties": {
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "selection": {
                "$ref": "#/$defs/timing"
              },
              "kind": {
                "const": "many_to_one"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "member_id",
                    "selection",
                    "kind",
                    "minuend_group_id",
                    "subtrahend_group_id"
                  ],
                  "properties": {
                    "member_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "$ref": "#/$defs/timing"
                    },
                    "kind": {
                      "const": "pair"
                    },
                    "minuend_group_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subtrahend_group_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "control_group_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_id", "analysis_id", "selection", "kind", "members"],
            "properties": {
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "selection": {
                "$ref": "#/$defs/timing"
              },
              "kind": {
                "const": "finite_contrasts"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["member_id", "selection", "kind", "coefficients"],
                  "properties": {
                    "member_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "$ref": "#/$defs/timing"
                    },
                    "kind": {
                      "const": "contrast"
                    },
                    "coefficients": {
                      "type": "array",
                      "minItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["group_id", "value"],
                        "properties": {
                          "group_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "result_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "analysis_id",
              "family_id",
              "contract_ref",
              "kind",
              "payload_status",
              "member_id"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "omnibus"
              },
              "payload_status": {
                "const": "method_payload_deferred"
              },
              "member_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "analysis_id",
              "family_id",
              "contract_ref",
              "kind",
              "payload_status",
              "member_ids"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "pairwise"
              },
              "payload_status": {
                "const": "method_payload_deferred"
              },
              "member_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "analysis_id",
              "family_id",
              "contract_ref",
              "kind",
              "payload_status",
              "member_ids"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "many_to_one"
              },
              "payload_status": {
                "const": "method_payload_deferred"
              },
              "member_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "analysis_id",
              "family_id",
              "contract_ref",
              "kind",
              "payload_status",
              "member_ids"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "planned_contrast"
              },
              "payload_status": {
                "const": "method_payload_deferred"
              },
              "member_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "analysis_id",
              "family_id",
              "contract_ref",
              "kind",
              "payload_status",
              "member_ids"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "multiplicity_adjustment"
              },
              "payload_status": {
                "const": "method_payload_deferred"
              },
              "member_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "analysis_id",
              "family_id",
              "contract_ref",
              "kind",
              "payload_status",
              "member_ids"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "interval"
              },
              "payload_status": {
                "const": "method_payload_deferred"
              },
              "member_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_to_outcome_inspection", "statement"],
      "properties": {
        "relative_to_outcome_inspection": {
          "enum": ["before", "after", "not_declared"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
