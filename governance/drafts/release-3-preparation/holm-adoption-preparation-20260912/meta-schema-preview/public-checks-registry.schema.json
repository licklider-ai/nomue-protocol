{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nrs:meta:public-checks-registry",
  "title": "NRS public check registry",
  "description": "Meta-schema for registries/public-checks.yaml. Tolerance policy is owned by check versions, never by Records.",
  "type": "object",
  "required": ["registry", "registry_version", "updated", "check_sets", "checks"],
  "additionalProperties": false,
  "properties": {
    "registry": {
      "const": "nrs-public-checks"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "check_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "check_ids"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+|https://nomue\\.ai/id/check/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)$"
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^NRS-(GOV|CORE|VERIFY|CANON|ATTEST|EXT|SEC|VERSION|INTEROP|PROV|EMIT|APPROVE|(CONTRACT|PROFILE)-[A-Z][A-Z0-9]{1,11})-[0-9]{4}$"
    },
    "tolerancePair": {
      "type": "object",
      "required": ["absolute", "relative"],
      "additionalProperties": false,
      "properties": {
        "absolute": {
          "type": "number",
          "minimum": 0
        },
        "relative": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tolerancePolicy": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["not_applicable", "exact", "numeric"]
        },
        "exact_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "numeric_tolerances": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/tolerancePair"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "numeric"
              }
            }
          },
          "then": {
            "required": ["numeric_tolerances"]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "required": [
        "check_id",
        "title",
        "version",
        "stability",
        "scope_kind",
        "calculation_evidence",
        "consistency_evidence",
        "signature_evidence",
        "claim_posture",
        "requirement_ids",
        "tolerance_policy",
        "implementation_status",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^(?:urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+|https://nomue\\.ai/id/check/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "stability": {
          "enum": ["CORE", "STABLE-INTENT", "EXPERIMENTAL"]
        },
        "scope_kind": {
          "enum": ["record", "record_revision", "analysis", "result"]
        },
        "calculation_evidence": {
          "enum": ["recomputed", "consistency_only", "not_checked"]
        },
        "consistency_evidence": {
          "enum": ["checked", "not_checked"]
        },
        "signature_evidence": {
          "enum": ["verified", "failed", "not_checked"]
        },
        "claim_posture": {
          "enum": ["asserted", "not_asserted"]
        },
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:urn:nomue:check:[a-z0-9-]+:[A-Za-z0-9.-]+|https://nomue\\.ai/id/check/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)$"
          }
        },
        "dependency_propagation": {
          "$comment": "Unissued additive proposal. Legacy check versions retain blocking reasons; the Holm successor uses its explicit prerequisite_failed reason. No old check meaning changes.",
          "enum": ["not_run_with_blocking_reason_codes", "not_run_with_prerequisite_reason"]
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "tolerance_policy": {
          "$ref": "#/$defs/tolerancePolicy"
        },
        "comparison_constants": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "$comment": "Machine-readable constants owned by the check version (e.g. the supported confidence level); the reference verifier fails loud if these disagree with the implemented profile constants.",
          "properties": {
            "supported_confidence_level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "supported_ci_method_id": {
              "type": "string",
              "pattern": "^urn:nomue:method:[a-z0-9-]+:[A-Za-z0-9.-]+$"
            },
            "supported_estimand_kind": {
              "type": "string",
              "minLength": 1
            },
            "holm_supplied_p": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "denominator_power_of_two",
                "exact_numerator_tolerance",
                "display_bits_tolerance",
                "projection",
                "sort",
                "alpha_input",
                "groups_min",
                "groups_max",
                "members_min",
                "members_max"
              ],
              "properties": {
                "denominator_power_of_two": {
                  "const": 1074
                },
                "exact_numerator_tolerance": {
                  "const": 0
                },
                "display_bits_tolerance": {
                  "const": 0
                },
                "projection": {
                  "const": "binary64_round_ties_to_even"
                },
                "sort": {
                  "const": "exact_p_then_original_index"
                },
                "alpha_input": {
                  "const": false
                },
                "groups_min": {
                  "const": 3
                },
                "groups_max": {
                  "const": 16
                },
                "members_min": {
                  "const": 3
                },
                "members_max": {
                  "const": 120
                }
              },
              "$comment": "Unissued fixed Holm candidate comparison constants. Does not change legacy check policies."
            }
          }
        },
        "implementation_status": {
          "enum": ["planned", "implemented"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
