{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "output_type",
    "stage",
    "refusal_kind",
    "reason_codes",
    "message",
    "verifier",
    "input_evidence",
    "generated_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://nomue.ai/id/schema/holm-supplied-p-refusal/0.3.0-candidate.1"
    },
    "output_type": {
      "const": "nomue-verifier-refusal"
    },
    "stage": {
      "enum": [
        "execution",
        "binding",
        "expected_context",
        "parsed",
        "raw",
        "reporting",
        "routing",
        "schema",
        "setup",
        "storage"
      ]
    },
    "refusal_kind": {
      "enum": [
        "canonicalization_failure",
        "execution_cancelled",
        "expected_context_error",
        "input_access_error",
        "internal_error",
        "noncanonical_storage",
        "parse_error",
        "resource_limit",
        "routing_error",
        "schema_error",
        "unsupported_bundle",
        "unsupported_execution"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "NRS-HOLM-ABNORMAL-EXIT",
          "NRS-HOLM-BUNDLE-MISSING",
          "NRS-HOLM-BUNDLE-TYPE",
          "NRS-HOLM-BUNDLE-UNSUPPORTED",
          "NRS-HOLM-CANCELLED",
          "NRS-HOLM-CLEANUP-FAILED",
          "NRS-HOLM-COMPLETED-INVALID-OUTPUT",
          "NRS-HOLM-DEADLINE",
          "NRS-HOLM-EXPECTED-BYTES",
          "NRS-HOLM-EXPECTED-CONTAINER",
          "NRS-HOLM-EXPECTED-DEPTH",
          "NRS-HOLM-EXPECTED-DUPLICATE-MEMBER",
          "NRS-HOLM-EXPECTED-INVALID-UNICODE",
          "NRS-HOLM-EXPECTED-KEY",
          "NRS-HOLM-EXPECTED-MALFORMED-JSON",
          "NRS-HOLM-EXPECTED-NEGATIVE-ZERO",
          "NRS-HOLM-EXPECTED-NODES",
          "NRS-HOLM-EXPECTED-PARSER-EXHAUSTION",
          "NRS-HOLM-EXPECTED-SCHEMA",
          "NRS-HOLM-EXPECTED-STRING",
          "NRS-HOLM-EXPECTED-TYPE",
          "NRS-HOLM-INTERNAL-FAILURE",
          "NRS-HOLM-INVALID-INPUT",
          "NRS-HOLM-LEGACY-ADMISSION-LIMIT",
          "NRS-HOLM-MEMORY-ENFORCED",
          "NRS-HOLM-OUTPUT-OVERFLOW",
          "NRS-HOLM-PIDS-ENFORCED",
          "NRS-HOLM-PROJECTION-DISAGREEMENT",
          "NRS-HOLM-RECORD-BYTES",
          "NRS-HOLM-RECORD-BYTES-TYPE",
          "NRS-HOLM-RECORD-CONTAINER",
          "NRS-HOLM-RECORD-DEPTH",
          "NRS-HOLM-RECORD-DUPLICATE-MEMBER",
          "NRS-HOLM-RECORD-INVALID-UNICODE",
          "NRS-HOLM-RECORD-KEY",
          "NRS-HOLM-RECORD-MALFORMED-JSON",
          "NRS-HOLM-RECORD-NEGATIVE-ZERO",
          "NRS-HOLM-RECORD-NODES",
          "NRS-HOLM-RECORD-NONFINITE",
          "NRS-HOLM-RECORD-PARSER-EXHAUSTION",
          "NRS-HOLM-RECORD-SCHEMA",
          "NRS-HOLM-RECORD-STRING",
          "NRS-HOLM-RECORD-UTF8",
          "NRS-HOLM-REPORT-INVARIANT",
          "NRS-HOLM-SETUP-FAILED",
          "NRS-HOLM-SETUP-FAILURE",
          "NRS-HOLM-STORED-BYTES-NONCANONICAL",
          "NRS-HOLM-UNSUPPORTED-HOST"
        ]
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "holm-public-candidate"
        },
        "version": {
          "const": "unissued-v1"
        }
      }
    },
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability"],
      "properties": {
        "availability": {
          "const": "not_observed"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "$comment": "RFC 3339 timestamp restricted to UTC with a Z suffix; numeric offsets are rejected. Field ranges are bounded; exact calendar validity (month lengths, leap years) is not fully expressible in a regex and is out of scope for Phase 1."
    },
    "limit_category": {
      "enum": [
        "binding_admission",
        "container_size",
        "file_size",
        "memory_limit",
        "nesting_depth",
        "node_count",
        "output_size",
        "parser_exhaustion",
        "processing_timeout",
        "string_length",
        "task_limit"
      ]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_stage", "codes", "bridge_reason"],
      "properties": {
        "source_stage": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "bridge_reason": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "refusal_kind": {
            "const": "resource_limit"
          }
        }
      },
      "then": {
        "required": ["limit_category"]
      },
      "else": {
        "not": {
          "required": ["limit_category"]
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomue.ai/id/schema/holm-supplied-p-refusal/0.3.0-candidate.1",
  "$comment": "Unissued R3 candidate. Proposed identities are not allocated or supported by the registered verifier."
}
